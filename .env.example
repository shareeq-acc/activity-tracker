# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
TZ=Asia/Karachi
APP_PORT=8765

# Shared secret. The collector must send this as X-Ingest-Token.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
INGEST_TOKEN=change-me

# Segments shorter than this are discarded as noise (seconds).
MIN_SEGMENT_SECONDS=2

# ---------------------------------------------------------------------------
# LLM providers. Both can be configured; you switch between them in the UI.
# ---------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=ollama

# Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Ollama. On Windows, install Ollama natively and leave this as-is: the
# container reaches the host through host.docker.internal.
# If you instead run the bundled CPU-only container (profile "local-llm"),
# set this to http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
